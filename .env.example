# Environment Variables

PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/statusflow"
REDIS_URL="redis://localhost:6379"
# Encrypts WhatsApp session credentials (packages/baileys-engine) before they're written to
# Redis — these are signal-protocol identity/session keys, equivalent to the account's
# credentials. Generate with `openssl rand -hex 32`. Must be the SAME value on both apps/api
# and apps/worker (one encrypts, the other decrypts) — a mismatch or missing key doesn't crash
# either process, but WhatsApp pairing/publishing will fail until it's set correctly.
SESSION_ENCRYPTION_KEY="generate-with-openssl-rand--hex-32"
SUPABASE_URL="https://your-supabase-project.supabase.co"
SUPABASE_ANON_KEY="your-anon-key"
# Project Settings > API > service_role key in the Supabase dashboard. Used server-side
# only (apps/api/src/storage.ts) to upload to the "status-media" Storage bucket — never
# send this to a client. Create that bucket as PUBLIC (read) before media upload will work;
# see docs/SUPABASE_SETUP.md.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Max simultaneous publish jobs apps/worker processes at once (each opens its own WhatsApp
# connection). Optional — defaults to 5 if unset.
WORKER_CONCURRENCY=5
PAYSTACK_SECRET_KEY="sk_test_xxx"
# Not currently read by any code path (checkout uses Paystack's hosted redirect flow, not
# Inline.js) — kept here only so it's documented if that changes.
PAYSTACK_PUBLIC_KEY="pk_test_xxx"
