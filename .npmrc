block-exotic-subdeps=false
allow-builds=true
# React Native's Gradle plugin resolves @react-native/gradle-plugin via both a direct
# node_modules symlink and Node's require.resolve (which returns a path inside pnpm's
# .pnpm virtual store) — with pnpm's default symlinked layout those are two different
# logical paths to the same physical directory, and Gradle's included-build dedup (which
# compares by build path name, not resolved location) sees a collision and fails with
# "has build path :gradle-plugin which is the same as included build ...". Hoisted
# layout (npm/yarn-style flat node_modules) avoids the dual-path resolution entirely —
# Expo's own pnpm guide recommends this for exactly this reason.
node-linker=hoisted
public-hoist-pattern[]=*

