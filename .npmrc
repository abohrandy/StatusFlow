# @whiskeysockets/baileys (packages/baileys-engine) requires `libsignal`, its
# signal-protocol crypto implementation, which WhiskeySockets only ships as a GitHub
# repo — never published to npm. pnpm's default `block-exotic-subdeps=true` (a supply-
# chain guard against unpinned git dependencies) refuses to install it. This is a known,
# unavoidable requirement of the Baileys ecosystem, not something specific to this repo.
# Scoped to this project only — not a global pnpm setting.
block-exotic-subdeps=false
